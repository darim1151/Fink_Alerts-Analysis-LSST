# Python/runtime caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.pid
*.trace
.cache/
.python_cache/
python_cache/

# Local credentials, auth material, and client secrets
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
*credential*
*credentials*
*secret*
*token*
*password*
fink_client*
fink-client*
kafka*.properties

# Root-level generated schema dumps from local Data Transfer runs
/arrow_schema_*
/avro_schema_*

# Local raw scientific data and generated processed tables
data/raw/**
data/raw/data_transfer/**/*.parquet
data/raw/data_transfer/**/*.json
data/raw/data_transfer/**/*.jsonl
data/raw/data_transfer/**/*.csv
data/raw/data_transfer/**/*.avro
!data/raw/
!data/raw/.gitkeep
!data/raw/**/
!data/raw/**/.gitkeep
!data/raw/data_transfer/**/.gitkeep

data/processed/**
!data/processed/
!data/processed/.gitkeep
!data/processed/**/
!data/processed/**/.gitkeep

# Lightweight fixtures are intentionally commit-visible
!data/fixtures/
!data/fixtures/**

# Generated reports, figures, and run artifacts are local by default
outputs/**
!outputs/
!outputs/.gitkeep
!outputs/maintenance/
!outputs/maintenance/*.md
!outputs/maintenance/*.json
!outputs/maintenance/*.txt

# Local archive recommendations may mention this path, but archive content stays local
outputs/archive/**
